# Linux CRM server secrets (.env on the office/home computer only)
# Generate long unique values; never commit this file.
LEADS_DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
LEAD_INGEST_TOKEN=CHANGE_ME_LONG_RANDOM_32_BYTES_OR_MORE
LEAD_WORKER_TOKEN=CHANGE_ME_DIFFERENT_LONG_RANDOM_TOKEN

# EspoCRM API integration user (server-to-server on the private Docker network)
ESPOCRM_API_KEY=CHANGE_ME
ESPOCRM_VERSION=latest
ESPOCRM_DB_ROOT_PASSWORD=CHANGE_ME_STRONG_MARIADB_ROOT_PASSWORD
ESPOCRM_DB_PASSWORD=CHANGE_ME_STRONG_MARIADB_PASSWORD
ESPOCRM_ADMIN_USERNAME=amyadmin
ESPOCRM_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ESPOCRM_SITE_URL=https://crm.amyelectric.com
ESPOCRM_LOCAL_PORT=8088
LEADS_DB_LOCAL_PORT=5433
LEAD_WORKER_BATCH_SIZE=25

# Email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@amyelectric.com
EMAIL_TO=info@amyelectric.com

# Cloudflare Tunnel connector token for the Linux server
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Cloudflare Worker secrets are set separately with Wrangler:
# LEAD_INGEST_TOKEN (same value as the Linux .env value above)
# CF_ACCESS_CLIENT_ID
# CF_ACCESS_CLIENT_SECRET
# LEAD_WORKER_TOKEN (same value as the Linux .env value above; scheduler auth)

# Google Analytics 4 (public website build variable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
