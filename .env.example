# Website lead storage (PostgreSQL application database)
DATABASE_URL=postgresql://amy_leads:CHANGE_ME@127.0.0.1:5433/amy_leads
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Self-hosted EspoCRM API (server-side only)
ESPOCRM_URL=https://crm.amyelectric.com
ESPOCRM_API_KEY=CHANGE_ME

# Protect the scheduled outbox worker endpoint with a long random token
LEAD_WORKER_TOKEN=CHANGE_ME_WITH_32_PLUS_RANDOM_BYTES
LEAD_WORKER_BATCH_SIZE=25

# Email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@amyelectric.com
EMAIL_TO=info@amyelectric.com

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# EspoCRM + MariaDB + PostgreSQL Docker Compose deployment secrets
ESPOCRM_VERSION=latest
ESPOCRM_DB_ROOT_PASSWORD=CHANGE_ME
ESPOCRM_DB_PASSWORD=CHANGE_ME
ESPOCRM_ADMIN_USERNAME=amyadmin
ESPOCRM_ADMIN_PASSWORD=CHANGE_ME
ESPOCRM_SITE_URL=https://crm.amyelectric.com
ESPOCRM_LOCAL_PORT=8088
LEADS_DB_PASSWORD=CHANGE_ME
LEADS_DB_LOCAL_PORT=5433
